# Copy to .env and fill in ONE provider key. Without any key the app runs in deterministic mock mode.

# auto | groq | gemini | openai | anthropic | mock
LLM_PROVIDER=auto
# LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Protects approve / reject / chaos / incident-resolve endpoints (leave empty for a demo)
ADMIN_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
SLO_LATENCY_MS=8000
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RESET_S=30
RATE_LIMIT_PER_MINUTE=30
